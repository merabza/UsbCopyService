{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5100"
      }
    }
  },

  "ApiKeys": {
    "AppSettingsByApiKey": [
      {
        "ApiKey": "",
        "RemoteIpAddress": ""
      },
      {
        "ApiKey": "",
        "RemoteIpAddress": ""
      }
    ]
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/UsbCopyService-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },

  "VersionInfo": {
    "AppSettingsVersion": "1.0"
  },

  "UsbCopySettings": {
    "WorkPath": "WorkPath",
    "FileStorages": {
      "Synology": {
        "FileStoragePath": "FileStoragePath",
        "UserName": "UserName",
        "Password": "Password",
        "FileNameMaxLength": 255,
        "FileSizeSplitPositionInRow": 4,
        "FtpSiteLsFileOffset": 71
      }
    },
    "Projects": {
      "From Synology": {
        "LocalPath": "LocalPath",
        "FileStorageName": "Synology",
        "ExcludeSetName": "GitBinObj"
      }
    }
  }
}
